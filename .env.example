# Copy this file to .env and fill in the values from your own backend project.
# These are read at build time by Vite (VITE_ prefix = exposed to the browser).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLISHABLE_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side only (not exposed to the browser).
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLISHABLE_KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
